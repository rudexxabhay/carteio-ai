# Application
NODE_ENV=development
# Optional Playground-only trace payload; enabled only in development or APP_ENV=uat.
PLAYGROUND_DIAGNOSTICS_ENABLED=false
# Raw model/debug text is highly sensitive. Keep false by default; true is allowed only for local development or explicit APP_ENV=uat with diagnostics enabled and authenticated owner/admin capture.
PLAYGROUND_RAW_DEBUG_ENABLED=false
# Retained Playground traces expire no later than their conversation; bounded to 1–24 hours.
PLAYGROUND_TRACE_RETENTION_HOURS=24
PORT=5000
HOST=127.0.0.1
API_PREFIX=api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=log
WIDGET_DEBUG_ENABLED=false
TRUST_PROXY_HOPS=0

# Database
DATABASE_URL=postgresql://USER:PASSWORD@NEON_POOLER_HOST/APP_DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@NEON_HOST/APP_DATABASE?sslmode=require

# Authentication
AUTH_SESSION_DAYS=14
PUBLIC_APP_URL=http://localhost:3000
AUTH_OTP_EXPIRES_MINUTES=5
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_RATE_LIMIT_ENABLED=true
AUTH_OTP_RATE_LIMIT_TEST_EMAILS=
# Private random value, at least 32 bytes.
AUTH_OTP_HASH_SECRET=GENERATE_A_RANDOM_SECRET_OF_32_BYTES_OR_MORE

# Authenticated Playground fixed-window limits (PostgreSQL-backed).
PLAYGROUND_USER_REQUESTS_PER_MINUTE=30
PLAYGROUND_WORKSPACE_REQUESTS_PER_MINUTE=120

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Email (Resend)
RESEND_API_KEY=YOUR_RESEND_API_KEY
AUTH_EMAIL_FROM="Carteio AI <no-reply@mail.carteio.in>"

# Knowledge indexing. Lexical retrieval needs no model key; keep the worker disabled until migrations are applied.
KNOWLEDGE_WORKER_ENABLED=false
# Optional isolated Linux browser worker; never enable without the Phase 08E isolation checks.
KNOWLEDGE_BROWSER_RENDERING_ENABLED=false
KNOWLEDGE_RENDERER_IMAGE=sha256:REPLACE_WITH_REVIEWED_LOCAL_IMAGE_ID
# All LLM and embedding traffic uses the single server-configured OpenRouter gateway/model. Visitor input never selects models. Credentials stay server-side.
AI_DEFAULT_PROVIDER=OPENROUTER
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter uses the exact model ID provided by OpenRouter; no backend model catalogue is hardcoded.
# Used by the existing chat provider and, when explicitly enabled, OpenRouter Knowledge embeddings.
# Semantic embeddings are optional. OpenRouter reuses OPENROUTER_API_KEY; this profile is independent of chat model routing.
KNOWLEDGE_SEMANTIC_ENABLED=false
KNOWLEDGE_EMBEDDING_PROVIDER=openrouter
KNOWLEDGE_EMBEDDING_MODEL=openai/text-embedding-3-small
KNOWLEDGE_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# Minimum cosine similarity before hybrid ranking; calibrate with approved offline fixtures.
KNOWLEDGE_SEMANTIC_MIN_SIMILARITY=0.3


TICKET_OUTBOX_WORKER_ENABLED=false
WIDGET_RETENTION_WORKER_ENABLED=false

# Generate a distinct 32-byte key; never reuse auth/OTP or provider credentials.
CONNECTOR_CREDENTIAL_ENCRYPTION_KEY=
CONNECTOR_CREDENTIAL_KEY_VERSION=v1
CONNECTOR_CREDENTIAL_PREVIOUS_KEYS=
CONNECTOR_SYNC_WORKER_ENABLED=false
CONNECTOR_SYNC_DEBUG=false
CONNECTOR_SYNC_POLL_MS=15000
CONNECTOR_SYNC_BATCH_SIZE=10
CONNECTOR_SYNC_MAX_ATTEMPTS=8
CONNECTOR_MAX_CONFIG_BYTES=16384
CONNECTOR_WEBHOOK_MAX_BYTES=262144
CONNECTOR_WEBHOOK_RATE_LIMIT_PER_MINUTE=60
# Phase 16 Shopify public app settings. Configure real app values before enabling installs.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_CALLBACK_URL=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_SCOPES=read_products,read_inventory,read_orders

# English PDF ingestion uses bounded in-memory extraction; it does not require a schema migration
# or permanent file storage. Set false only to pause new PDF uploads explicitly.
KNOWLEDGE_DOCUMENTS_ENABLED=true
# Legacy private PDF cleanup/read only (not required for new uploads). When enabled in local
# development, this must be an absolute directory OUTSIDE the checkout and public/static trees.
KNOWLEDGE_PRIVATE_STORAGE_ROOT=
