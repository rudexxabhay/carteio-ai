// Credentials are deliberately represented by an opaque secret reference. This
// application has no configured KMS/secret vault, so connection rows never
// accept or persist raw credentials.
model IntegrationConnection {
  id                 String                     @id @default(uuid()) @db.Uuid
  organizationId     String                     @db.Uuid
  platform           IntegrationPlatform
  displayName        String                     @db.VarChar(200)
  siteUrl            String?                    @db.VarChar(2048)
  externalAccountId  String?                    @db.VarChar(255)
  state              IntegrationConnectionState @default(DRAFT)
  secretReference    String?                    @db.VarChar(512)
  grantedScopes      String[]                   @default([])
  grantedScopeMetadata Json                     @default("[]") @db.JsonB
  grantedScopesVerifiedAt DateTime?              @db.Timestamptz(3)
  lastErrorCode      String?                    @db.VarChar(100)
  lastSyncAt         DateTime?                  @db.Timestamptz(3)
  lastSuccessfulSyncAt DateTime?                @db.Timestamptz(3)
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @db.Timestamptz(3)
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  syncJobs           CommerceSyncJob[]
  products           CommerceProduct[]
  orders             CommerceOrder[]
  commerceConnector ConnectorInstance?

  @@unique([id, organizationId])
  @@index([organizationId, state, updatedAt])
  @@index([organizationId, platform, createdAt])
}

