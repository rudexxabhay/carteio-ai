generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REMOVED
}

enum WebsiteVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
}

model User {
  id                String                   @id @default(uuid()) @db.Uuid
  email             String                   @unique @db.VarChar(320)
  name              String?                  @db.VarChar(200)
  emailVerifiedAt   DateTime?                @db.Timestamptz(3)
  status            RecordStatus             @default(ACTIVE)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(3)
  memberships       OrganizationMembership[]
  auditEvents       AuditEvent[]
  credential        PasswordCredential?
  sessions          UserSession[]
  verificationTokens EmailVerificationToken[]
  resetTokens       PasswordResetToken[]
  identities        AuthIdentity[]

  @@index([status, createdAt])
}

model PasswordCredential {
  userId       String   @id @db.Uuid
  passwordHash String   @db.VarChar(255)
  changedAt    DateTime @default(now()) @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AuthIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  provider        String   @db.VarChar(32)
  providerSubject String   @db.VarChar(255)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
}

model EmailOtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique @db.VarChar(320)
  codeHash    String    @db.Char(64)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  attempts    Int       @default(0)
  consumedAt  DateTime? @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([consumedAt, createdAt])
}

model Organization {
  id          String                   @id @default(uuid()) @db.Uuid
  name        String                   @db.VarChar(200)
  slug        String                   @unique @db.VarChar(63)
  status      RecordStatus             @default(ACTIVE)
  createdAt   DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                 @updatedAt @db.Timestamptz(3)
  memberships OrganizationMembership[]
  websites    Website[]
  chatbots    Chatbot[]
  integrations Integration[]
  auditEvents AuditEvent[]

  @@index([status, createdAt])
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  role           MembershipRole   @default(MEMBER)
  status         MembershipStatus @default(PENDING)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // One row is reactivated when membership returns; this prevents duplicate active rows.
  @@unique([userId, organizationId])
  @@index([organizationId, status, role])
  @@index([userId, status])
}

model Website {
  id                 String                    @id @default(uuid()) @db.Uuid
  organizationId     String                    @db.Uuid
  name               String                    @db.VarChar(200)
  domain             String                    @db.VarChar(253)
  verificationStatus WebsiteVerificationStatus @default(UNVERIFIED)
  status             RecordStatus              @default(ACTIVE)
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @db.Timestamptz(3)
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chatbots           Chatbot[]
  integrations       Integration[]

  @@unique([id, organizationId])
  @@unique([organizationId, domain])
  @@index([organizationId, status])
}

model Chatbot {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  websiteId      String?       @db.Uuid
  name           String        @db.VarChar(200)
  status         RecordStatus  @default(ACTIVE)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  website        Website?      @relation(fields: [websiteId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([websiteId, organizationId])
}

model Integration {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  websiteId      String?       @db.Uuid
  providerType   String        @db.VarChar(64)
  status         RecordStatus  @default(ACTIVE)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  website        Website?      @relation(fields: [websiteId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, status])
  @@index([websiteId, organizationId])
}

model AuditEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  actorUserId    String?       @db.Uuid
  action         String        @db.VarChar(120)
  entityType     String        @db.VarChar(80)
  entityId       String?       @db.VarChar(128)
  // Restrict metadata to reviewed, non-secret event attributes in service code.
  metadata       Json?         @db.JsonB
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUser      User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
}
