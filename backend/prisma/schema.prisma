  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  actor       User @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
}

// Durable inbox records only contain content that arrives through an authorized
// support channel. No route currently creates these from Playground messages.
model SupportConversation {
  id                 String @id @default(uuid()) @db.Uuid
  organizationId     String @db.Uuid
  assistantId        String @db.Uuid
  externalSessionHash String @db.Char(64)
  channel            String @db.VarChar(32)
  state              InboxConversationState @default(OPEN)
  assignedToUserId   String? @db.Uuid
  resolvedAt         DateTime? @db.Timestamptz(3)
  lastMessageAt      DateTime? @db.Timestamptz(3)
  lastCustomerMessageAt DateTime? @db.Timestamptz(3)
  lastMessagePreview String? @db.VarChar(500)
  messageCount       Int @default(0)
  activeRequestId    String? @db.Uuid
  activeRequestUntil DateTime? @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assistant          Chatbot @relation(fields: [assistantId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  assignee           User? @relation("InboxAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  messages           SupportMessage[]
  readStates         SupportConversationReadState[]
  tickets Ticket[]
  ticketDrafts TicketDraft[]
  widgetSessions WidgetSession[]

  @@unique([organizationId, assistantId, externalSessionHash])
  @@unique([id, organizationId])
  @@index([organizationId, state, lastMessageAt])
  @@index([organizationId, assistantId, state, lastMessageAt])
  @@index([organizationId, channel, lastMessageAt])
  @@index([assignedToUserId, state, lastMessageAt])
}

model WidgetSession {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  assistantId String @db.Uuid
  conversationId String @db.Uuid
  accessTokenHash String @unique @db.Char(64)
  resumeTokenHash String @db.Char(64)
  visitorSessionId String @db.VarChar(64)
  origin String @db.VarChar(512)
  accessExpiresAt DateTime @db.Timestamptz(3)
  resumeExpiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assistant Chatbot @relation(fields: [assistantId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  conversation SupportConversation @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  @@index([resumeTokenHash, resumeExpiresAt])
  @@index([organizationId, assistantId, conversationId, accessExpiresAt])
}

model SupportMessage {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  conversationId String @db.Uuid
  authorUserId   String? @db.Uuid
  kind           InboxMessageKind
  content        String @db.Text
  provider       String? @db.VarChar(40)
  model          String? @db.VarChar(120)
  responseCategory String? @db.VarChar(64)
  answerOrigin   String? @db.VarChar(40)
  idempotencyKey String? @db.VarChar(160)
  sourceRefs     Json? @db.JsonB
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  conversation   SupportConversation @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  author         User? @relation("SupportMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  outboundDelivery OutboundDelivery?
  ticketId String? @db.Uuid
  ticket Ticket? @relation(fields: [ticketId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)

  @@index([organizationId, conversationId, createdAt])
  @@unique([organizationId, conversationId, idempotencyKey])
}

model SupportConversationReadState {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  conversationId String @db.Uuid
  userId         String @db.Uuid
  readAt         DateTime @default(now()) @db.Timestamptz(3)
  isRead         Boolean @default(false)
  conversation  SupportConversation @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([conversationId, userId])
  @@index([organizationId, userId, readAt])
}


model Ticket {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  assistantId String @db.Uuid
  conversationId String @db.Uuid
  reference String @db.VarChar(24)
  title String @db.VarChar(180)
  description String @db.Text
  category String @db.VarChar(80)
  priority TicketPriority @default(MEDIUM)
  status TicketStatus @default(OPEN)
  customerReference String? @db.VarChar(80)
  creationSource String @default("AI_CONVERSATION") @db.VarChar(32)
  assignedToUserId String? @db.Uuid
  resolutionRemarks String? @db.VarChar(2000)
  version Int @default(1)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assistant Chatbot @relation(fields: [assistantId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  conversation SupportConversation @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  assignee User? @relation("TicketAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  events TicketEvent[]
  notes TicketInternalNote[]
  deliveries OutboundDelivery[]
  drafts TicketDraft[]
  messages SupportMessage[]
  @@unique([organizationId, reference])
  @@unique([id, organizationId])
  @@index([organizationId, status, updatedAt, id])
  @@index([organizationId, title])
  @@index([organizationId, customerReference])
  @@index([organizationId, category])
  @@index([organizationId, priority, updatedAt])
  @@index([organizationId, assistantId, status, updatedAt])
  @@index([organizationId, assistantId, conversationId, expiresAt])
  @@index([organizationId, assignedToUserId, status, updatedAt])
}

model TicketDraft {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  assistantId String @db.Uuid
  conversationId String @db.Uuid
  externalSessionHash String @db.Char(64)
  state TicketDraftState @default(COLLECTING)
  version Int @default(1)
  title String? @db.VarChar(180)
  description String? @db.Text
  category String? @db.VarChar(80)
  priority TicketPriority @default(MEDIUM)
  idempotencyKey String @db.VarChar(160)
  ticketId String? @unique @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  conversation SupportConversation @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assistant Chatbot @relation(fields: [assistantId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, assistantId, externalSessionHash, state, expiresAt])
}

model TicketEvent {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  ticketId String @db.Uuid
  actorUserId String? @db.Uuid
  eventType String @db.VarChar(48)
  fromValue String? @db.VarChar(80)
  toValue String? @db.VarChar(80)
  metadata Json? @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  ticket Ticket @relation(fields: [ticketId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  @@index([organizationId, ticketId, createdAt, id])
}

model TicketInternalNote {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  ticketId String @db.Uuid
  authorUserId String @db.Uuid
  content String @db.VarChar(4000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  ticket Ticket @relation(fields: [ticketId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  author User @relation(fields: [authorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([organizationId, ticketId, createdAt, id])
}

model OutboundDelivery {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  ticketId String @db.Uuid
  conversationId String @db.Uuid
  messageId String @unique @db.Uuid
  state OutboundDeliveryState @default(QUEUED)
  channel String @db.VarChar(32)
  attemptCount Int @default(0)
  nextAttemptAt DateTime? @db.Timestamptz(3)
  lastErrorCode String? @db.VarChar(80)
  leaseToken String? @db.VarChar(64)
  leaseUntil DateTime? @db.Timestamptz(3)
  permanentFailure Boolean @default(false)
  sentAt DateTime? @db.Timestamptz(3)
  deliveredAt DateTime? @db.Timestamptz(3)
  failedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ticket Ticket @relation(fields: [ticketId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  message SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attempts OutboundDeliveryAttempt[]
  @@unique([id, organizationId])
  @@index([organizationId, state, nextAttemptAt, createdAt])
  @@index([state, leaseUntil, createdAt])
  @@index([state, channel, createdAt])
  @@index([conversationId, createdAt])
}

model OutboundDeliveryAttempt {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  deliveryId String @db.Uuid
  attemptNumber Int
  state OutboundDeliveryState
  transportEventId String? @unique @db.VarChar(160)
  detailCode String? @db.VarChar(80)
  retryable Boolean @default(false)
  completedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  delivery OutboundDelivery @relation(fields: [deliveryId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([deliveryId, attemptNumber])
  @@index([organizationId, deliveryId, createdAt])
}

model FlowDefinition {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  assistantId    String       @db.Uuid
  name           String       @db.VarChar(200)
  version        Int          @default(1)
  graph          Json         @db.JsonB
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assistant      Chatbot      @relation(fields: [assistantId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([id, organizationId])
  @@unique([organizationId, assistantId, name])
  @@index([organizationId, assistantId, updatedAt])
}

model WorkflowExecution {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  assistantId    String @db.Uuid
  requestedBy    String? @db.Uuid
  idempotencyKey String @db.VarChar(160)
  actionKey      String @db.VarChar(100)
  argumentHash   String @db.Char(64)
  state          WorkflowExecutionState @default(PROPOSED)
  stepLimit      Int @default(8)
  deadlineAt     DateTime @db.Timestamptz(3)
  safeResult     Json? @db.JsonB
  errorCode      String? @db.VarChar(100)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assistant      Chatbot @relation(fields: [assistantId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  requester      User? @relation("WorkflowRequester", fields: [requestedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  steps          WorkflowStep[]
  approval       WorkflowApproval?

  @@unique([organizationId, idempotencyKey])
  @@unique([id, organizationId])
  @@index([organizationId, state, createdAt])
  @@index([deadlineAt, state])
}

model WorkflowStep {
  id           String @id @default(uuid()) @db.Uuid
  executionId  String @db.Uuid
  sequence     Int
  toolKey      String @db.VarChar(100)
  state        WorkflowStepState @default(PENDING)
  safeInput    Json @db.JsonB
  safeOutput   Json? @db.JsonB
  errorCode    String? @db.VarChar(100)
  startedAt    DateTime? @db.Timestamptz(3)
  finishedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  execution    WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([executionId, sequence])
  @@index([state, createdAt])
}

model WorkflowApproval {
  id           String @id @default(uuid()) @db.Uuid
  executionId  String @unique @db.Uuid
  argumentHash String @db.Char(64)
  status       String @default("PENDING") @db.VarChar(24)
  approvedById String? @db.Uuid
  expiresAt    DateTime @db.Timestamptz(3)
  decidedAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  execution    WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  approvedBy   User? @relation(fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, expiresAt])
}
