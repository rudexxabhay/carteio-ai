generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REMOVED
}

enum WebsiteVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
}

enum KnowledgeSyncPolicy {
  MANUAL
  DAILY
  WEEKLY
}

enum AssistantStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum KnowledgeSourceType {
  WEBSITE
  FAQ
  TEXT
}

enum KnowledgeSourceStatus {
  REGISTERED
  DISABLED
  ARCHIVED
}

enum KnowledgeProcessingStatus {
  NOT_PROCESSED
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum KnowledgeSemanticStatus {
  NOT_CONFIGURED
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum KnowledgeVisibility {
  INTERNAL_RESTRICTED
  PUBLIC_REFERENCE
}

enum KnowledgeBaseStatus {
  ACTIVE
  ARCHIVED
}

enum KnowledgeJobStatus {
  QUEUED
  PROCESSING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  CANCELLED
}

enum IntegrationPlatform {
  SHOPIFY
  WOOCOMMERCE
  WORDPRESS
  CUSTOM_API
  STATIC_WEBSITE
}

enum IntegrationConnectionState {
  DRAFT
  PENDING_VERIFICATION
  CONNECTED
  SYNCING
  CONNECTED_WITH_WARNINGS
  ERROR
  DISCONNECTED
  REVOKED
}

enum CommerceSyncState {
  PENDING
  SYNCING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ConnectorInstanceState {
  DRAFT
  CONNECTING
  CONNECTED
  DEGRADED
  ERROR
  DISCONNECTED
}

enum ConnectorSyncJobState {
  PENDING
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ConnectorSyncMode {
  FULL
  INCREMENTAL
}

enum ConnectorWebhookState {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum PlatformRole {
  SUPPORT
  OPERATIONS
  ADMIN
}

enum SubscriptionState {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  SETUP_REQUIRED
}

enum InboxConversationState {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum InboxMessageKind {
  CUSTOMER
  AI
  HUMAN
  BUSINESS_TEAM
  INTERNAL_NOTE
  SYSTEM
}

enum TicketStatus {
  OPEN
  ACTIVE
  PENDING
  CLOSED
}
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
enum TicketDraftState {
  COLLECTING
  AWAITING_CONFIRMATION
  CONFIRMED
  CANCELLED
  EXPIRED
}
enum OutboundDeliveryState {
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
  UNSUPPORTED_CHANNEL
}

enum WorkflowExecutionState {
  PROPOSED
  AWAITING_APPROVAL
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum WorkflowStepState {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

model User {
  id                String                   @id @default(uuid()) @db.Uuid
  email             String                   @unique @db.VarChar(320)
  name              String?                  @db.VarChar(200)
  emailVerifiedAt   DateTime?                @db.Timestamptz(3)
  status            RecordStatus             @default(ACTIVE)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(3)
  memberships       OrganizationMembership[]
  auditEvents       AuditEvent[]
  credential        PasswordCredential?
  sessions          UserSession[]
  verificationTokens EmailVerificationToken[]
  resetTokens       PasswordResetToken[]
  identities        AuthIdentity[]
  createdChatbots    Chatbot[]                @relation("ChatbotCreator")
  createdKnowledgeSources KnowledgeSource[]    @relation("KnowledgeSourceCreator")
  createdKnowledgeBases KnowledgeBase[]       @relation("KnowledgeBaseCreator")
  playgroundConversations PlaygroundConversation[]
  platformOperator PlatformOperator?
  platformAuditEvents PlatformAuditEvent[]
  assignedInboxConversations SupportConversation[] @relation("InboxAssignee")
  supportConversationReadStates SupportConversationReadState[]
  supportMessages SupportMessage[] @relation("SupportMessageAuthor")
  ticketsAssigned Ticket[] @relation("TicketAssignee")
  ticketEvents TicketEvent[]
  ticketNotes TicketInternalNote[]
  workflowApprovals WorkflowApproval[]
  workflowRequests WorkflowExecution[] @relation("WorkflowRequester")
  shopifyOAuthStates ShopifyOAuthState[]

  @@index([status, createdAt])
}

model PasswordCredential {
  userId       String   @id @db.Uuid
  passwordHash String   @db.VarChar(255)
  changedAt    DateTime @default(now()) @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AuthIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  provider        String   @db.VarChar(32)
  providerSubject String   @db.VarChar(255)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
}

model EmailOtpChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique @db.VarChar(320)
  codeHash    String    @db.Char(64)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  attempts    Int       @default(0)
  consumedAt  DateTime? @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([consumedAt, createdAt])
}

model Organization {
  id          String                   @id @default(uuid()) @db.Uuid
  name        String                   @db.VarChar(200)
  slug        String                   @unique @db.VarChar(63)
  websiteUrl  String?                  @db.VarChar(2048)
  businessType String?                 @db.VarChar(80)
  timezone    String                   @default("UTC") @db.VarChar(80)
  locale      String                   @default("en") @db.VarChar(35)
  status      RecordStatus             @default(ACTIVE)
  createdAt   DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                 @updatedAt @db.Timestamptz(3)
  memberships OrganizationMembership[]
  websites    Website[]
  chatbots    Chatbot[]
  flowDefinitions FlowDefinition[]
  integrations Integration[]
  auditEvents AuditEvent[]
  knowledgeSources KnowledgeSource[]
  knowledgeBases KnowledgeBase[]
  knowledgeBaseSources KnowledgeBaseSource[]
  assistantKnowledgeSources AssistantKnowledgeSource[]
  assistantKnowledgeBases AssistantKnowledgeBase[]
  assistantBusinessRules AssistantBusinessRule[]
  knowledgeJobs KnowledgeProcessingJob[]
  knowledgePages KnowledgePage[]
  knowledgeChunks KnowledgeChunk[]
  knowledgeSyncRuns KnowledgeSyncRun[]
  connectorDataPermissions ConnectorDataPermission[]
  assistantConnectorDataPermissions AssistantConnectorDataPermission[]
  playgroundConversations PlaygroundConversation[]
  integrationConnections IntegrationConnection[]
  commerceProducts CommerceProduct[]
  commerceOrders CommerceOrder[]
  subscriptions WorkspaceSubscription[]
  usageLedger UsageLedgerEntry[]
  supportConversations SupportConversation[]
  tickets Ticket[]
  ticketDrafts TicketDraft[]
  ticketEvents TicketEvent[]
  ticketNotes TicketInternalNote[]
  outboundDeliveries OutboundDelivery[]
  outboundDeliveryAttempts OutboundDeliveryAttempt[]
  workflowExecutions WorkflowExecution[]
  widgetConfigurations WidgetConfiguration[]
  widgetSessions WidgetSession[]
  connectorInstances ConnectorInstance[]
  connectorCredentials ConnectorCredential[]
  connectorSyncJobs ConnectorSyncJob[]
  connectorSyncSchedules ConnectorSyncSchedule[]
  connectorWebhookEvents ConnectorWebhookEvent[]
  shopifyOAuthStates ShopifyOAuthState[]

  @@index([status, createdAt])
}

model WidgetConfiguration {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  assistantId String @unique @db.Uuid
  publicId String @unique @default(cuid()) @db.VarChar(32)
  enabled Boolean @default(false)
  allowedDomains Json @default("[]") @db.JsonB
  appearance Json @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  assistant Chatbot @relation(fields: [assistantId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([id, organizationId])
  @@unique([assistantId, organizationId])
  @@index([organizationId, enabled])
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  role           MembershipRole   @default(MEMBER)
  status         MembershipStatus @default(PENDING)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // One row is reactivated when membership returns; this prevents duplicate active rows.
  @@unique([userId, organizationId])
  @@index([organizationId, status, role])
  @@index([userId, status])
}

model Website {
  id                 String                    @id @default(uuid()) @db.Uuid
  organizationId     String                    @db.Uuid
  name               String                    @db.VarChar(200)
  domain             String                    @db.VarChar(253)
  verificationStatus WebsiteVerificationStatus @default(UNVERIFIED)
  status             RecordStatus              @default(ACTIVE)
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @db.Timestamptz(3)
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chatbots           Chatbot[]
  integrations       Integration[]

  @@unique([id, organizationId])
  @@unique([organizationId, domain])
  @@index([organizationId, status])
}

model Chatbot {
  id                  String          @id @default(uuid()) @db.Uuid
  organizationId      String          @db.Uuid
  websiteId           String?         @db.Uuid
  createdById         String?         @db.Uuid
  name                String          @db.VarChar(200)
  description         String?         @db.VarChar(1000)
  aiProvider          String?         @db.VarChar(20)
  aiModel             String?         @db.VarChar(120)
  providerMode        String          @default("MANUAL") @db.VarChar(20)
  providerFallbacks   Json            @default("[]") @db.JsonB
  businessPurpose     String?         @db.VarChar(500)
  systemInstructions  String?         @db.VarChar(10000)
  defaultLanguage     String          @default("en") @db.VarChar(35)
  responseTone        String          @default("professional") @db.VarChar(32)
  responseStyle       String          @default("balanced") @db.VarChar(20)
  useAllEligibleWorkspaceKnowledge Boolean @default(false)
  fallbackMessage     String          @default("I’m not able to help with that right now. Please contact the business directly.") @db.VarChar(500)
  greetingMessage     String?         @db.VarChar(500)
  escalationMessage   String?         @db.VarChar(500)
  status              AssistantStatus @default(DRAFT)
  archivedAt          DateTime?       @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  website             Website?        @relation(fields: [websiteId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  createdBy           User?           @relation("ChatbotCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  knowledgeSources    AssistantKnowledgeSource[]
  connectorDataPermissions AssistantConnectorDataPermission[]
  knowledgeBases      AssistantKnowledgeBase[]
  businessRules       AssistantBusinessRule[]
  playgroundConversations PlaygroundConversation[]
  supportConversations SupportConversation[]
  tickets Ticket[]
  ticketDrafts TicketDraft[]
  workflowExecutions WorkflowExecution[]
  flowDefinitions FlowDefinition[]
  widgetConfiguration WidgetConfiguration?
  widgetSessions WidgetSession[]

  @@unique([id, organizationId])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, archivedAt, updatedAt])
  @@index([websiteId, organizationId])
}

model AssistantBusinessRule {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  assistantId    String       @db.Uuid
  title          String       @db.VarChar(160)
  instruction    String       @db.VarChar(2000)
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assistant      Chatbot      @relation(fields: [assistantId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([id, organizationId])
  @@index([organizationId, assistantId, enabled, updatedAt], map: "AssistantBusinessRule_org_assistant_enabled_updated_idx")
}

model PlaygroundConversation {
  id                 String               @id @default(uuid()) @db.Uuid
  organizationId     String               @db.Uuid
  assistantId        String               @db.Uuid
  userId             String               @db.Uuid
  channel            String               @default("PLAYGROUND") @db.VarChar(32)
  nextSequence       Int                  @default(0)
  activeRequestId    String?              @db.Uuid
  activeRequestUntil DateTime?            @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(3)
  expiresAt          DateTime             @db.Timestamptz(3)
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assistant          Chatbot              @relation(fields: [assistantId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  messages           PlaygroundMessage[]

  @@unique([id, organizationId])
  @@index([organizationId, assistantId, userId, expiresAt])
  @@index([expiresAt])
}

model PlaygroundMessage {
  id               String                @id @default(uuid()) @db.Uuid
  organizationId   String                @db.Uuid
  conversationId   String                @db.Uuid
  sequence         Int
  clientTurnId     String?               @db.Uuid
  role             String                @db.VarChar(16)
  content          String                @db.Text
  responseCategory String?               @db.VarChar(40)
  answerOrigin     String?               @db.VarChar(40)
  providerUsed     String?               @db.VarChar(20)
  modelUsed        String?               @db.VarChar(120)
  sourceReferences Json?                 @db.JsonB
  inputTokens      Int?
  outputTokens     Int?
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  conversation     PlaygroundConversation @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([conversationId, sequence])
  @@unique([organizationId, clientTurnId])
  @@index([organizationId, conversationId, createdAt])
}

model PlaygroundRateLimit {
  scopeKey       String   @id @db.VarChar(160)
  windowStartedAt DateTime @db.Timestamptz(3)
  requestCount   Int      @default(0)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@index([updatedAt])
}

model Integration {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  websiteId      String?       @db.Uuid
  providerType   String        @db.VarChar(64)
  status         RecordStatus  @default(ACTIVE)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  website        Website?      @relation(fields: [websiteId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, status])
  @@index([websiteId, organizationId])
}

model ConnectorInstance {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  connectorId String @db.VarChar(80)
  connectorType String @db.VarChar(40)
  connectorVersion String @db.VarChar(32)
  displayName String @db.VarChar(160)
  configuration Json @db.JsonB
  state ConnectorInstanceState @default(DRAFT)
  verifiedCapabilities Json @default("[]") @db.JsonB
  webhookPublicId String? @unique @db.VarChar(64)
  integrationConnectionId String? @unique @db.Uuid
  lastVerifiedAt DateTime? @db.Timestamptz(3)
  lastErrorCode String? @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  credential ConnectorCredential?
  syncJobs ConnectorSyncJob[]
  syncSchedules ConnectorSyncSchedule[]
  webhookEvents ConnectorWebhookEvent[]
  dataPermissions ConnectorDataPermission[]
  assistantDataPermissions AssistantConnectorDataPermission[]
  shopifyOAuthStates ShopifyOAuthState[]
  commerceConnection IntegrationConnection? @relation(fields: [integrationConnectionId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  @@unique([id, organizationId])
  @@unique([integrationConnectionId, organizationId])
  @@index([organizationId, state, updatedAt])
  @@index([organizationId, connectorId, createdAt])
}

model ConnectorDataPermission {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  connectorInstanceId String @db.Uuid
  category String @db.VarChar(40)
  enabled Boolean @default(false)
  syncEnabled Boolean @default(false)
  updatedById String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  connector ConnectorInstance @relation(fields: [connectorInstanceId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  @@unique([organizationId, connectorInstanceId, category])
  @@index([organizationId, category, enabled])
}

model AssistantConnectorDataPermission {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  connectorInstanceId String @db.Uuid
  assistantId String @db.Uuid
  category String @db.VarChar(40)
  enabled Boolean @default(false)
  updatedById String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  connector ConnectorInstance @relation(fields: [connectorInstanceId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  assistant Chatbot @relation(fields: [assistantId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  @@unique([organizationId, connectorInstanceId, assistantId, category])
  @@index([organizationId, assistantId, category, enabled])
}

model ConnectorCredential {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  connectorInstanceId String @unique @db.Uuid
  ciphertext Bytes
  nonce Bytes @db.ByteA
  authTag Bytes @db.ByteA
  keyVersion String @db.VarChar(32)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  connector ConnectorInstance @relation(fields: [connectorInstanceId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  @@unique([connectorInstanceId, organizationId])
  @@index([organizationId, connectorInstanceId])
}

model ConnectorSyncJob {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  connectorInstanceId String @db.Uuid
  resourceType String @db.VarChar(64)
  mode ConnectorSyncMode @default(INCREMENTAL)
  state ConnectorSyncJobState @default(PENDING)
  checkpoint Json? @db.JsonB
  cursor String? @db.VarChar(2048)
  idempotencyKey String @db.VarChar(160)
  attemptCount Int @default(0)
  maxAttempts Int @default(8)
  scheduledAt DateTime @default(now()) @db.Timestamptz(3)
  leaseToken String? @db.VarChar(64)
  leaseUntil DateTime? @db.Timestamptz(3)
  lastErrorCode String? @db.VarChar(100)
  itemCount Int @default(0)
  startedAt DateTime? @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  connector ConnectorInstance @relation(fields: [connectorInstanceId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  @@unique([organizationId, connectorInstanceId, idempotencyKey])
  @@index([organizationId, connectorInstanceId, createdAt, id])
  @@index([state, scheduledAt, leaseUntil, createdAt])
}

model ConnectorSyncSchedule {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  connectorInstanceId String @db.Uuid
  resourceType String @db.VarChar(64)
  mode ConnectorSyncMode @default(INCREMENTAL)
  enabled Boolean @default(false)
  paused Boolean @default(false)
  intervalMinutes Int @default(1440)
  nextRunAt DateTime? @db.Timestamptz(3)
  lastRunAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  connector ConnectorInstance @relation(fields: [connectorInstanceId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade)
  @@unique([organizationId, connectorInstanceId, resourceType])
  @@index([enabled, paused, nextRunAt, id])
  @@index([organizationId, connectorInstanceId, enabled])
}

model ConnectorWebhookEvent {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  connectorInstanceId String @db.Uuid
  externalEventId String @db.VarChar(200)
  eventType String @db.VarChar(120)
  rawBodyCiphertext Bytes
  rawBodyNonce Bytes @db.ByteA
  rawBodyAuthTag Bytes @db.ByteA
  rawBodyKeyVersion String @db.VarChar(32)
  payloadHash String @db.Char(64)
  state ConnectorWebhookState @default(RECEIVED)
  attemptCount Int @default(0)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz(3)
  leaseToken String? @db.VarChar(64)
  leaseUntil DateTime? @db.Timestamptz(3)
