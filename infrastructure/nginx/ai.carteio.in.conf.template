# Production TLS server template. Install real certificate paths only during deployment.
# Keep the NestJS upstream on a private network; never expose port 5000 publicly.
upstream carteio_api {
    server backend:5000;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name ai.carteio.in;

    # Deployment operator supplies certificate and key paths after provisioning TLS.
    ssl_certificate     /etc/letsencrypt/live/ai.carteio.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ai.carteio.in/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;

    root /srv/carteio/frontend;
    index index.html;
    client_max_body_size 1m;
    access_log /var/log/nginx/carteio_access.log;
    error_log  /var/log/nginx/carteio_error.log warn;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # API locations are handled before the SPA and return API errors as JSON.
    location = /api/v1 { return 308 /api/v1/; }
    location ^~ /api/v1/ {
        proxy_pass http://carteio_api; # No URI suffix: preserves /api/v1/... exactly.
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Preserve the browser-generated UUID when present; the API validates it and
        # generates its own UUID when absent or malformed.
        proxy_set_header X-Request-ID $http_x_request_id;
        proxy_buffering off; # Supports future SSE without changing the API prefix.
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_connect_timeout 5s;
        proxy_intercept_errors off;
    }

    location = /robots.txt { try_files $uri =404; }
    location = /sitemap.xml { try_files $uri =404; }
    location = /index.html { expires -1; }
    location = /widget.js {
        try_files $uri =404;
        default_type application/javascript;
        expires off;
        etag off;
        if_modified_since off;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    }
    location / { try_files $uri $uri/ /index.html; }
}
