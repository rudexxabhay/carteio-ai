# Application
VITE_API_BASE_URL=/api/v1
# Required in production: the public Carteio deployment origin that serves /widget.js.
# It may be the dashboard's origin; no dedicated widget hostname is required.
VITE_WIDGET_HOSTING_ORIGIN=
# Optional. When unset, the widget API uses the script hosting origin.
VITE_WIDGET_API_ORIGIN=

# Google Login
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
# VITE_* values are public in the browser bundle. Never put secrets here.
