{
  "name": "carteio-ai",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @carteio/frontend --filter @carteio/backend dev",
    "dev:frontend": "pnpm --filter @carteio/frontend dev",
    "dev:backend": "pnpm --filter @carteio/backend dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
